{
  "name": "app",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "build": {
    "command": "rm -rf site && mkdir site && cp -r index.html manifest.webmanifest sw.js icons app img gunluk site/"
  },
  "assets": {
    "directory": "./site",
    "not_found_handling": "single-page-application"
  }
}
